{
  "name": "undo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "pnpm --filter support-agent demo",
    "test": "pnpm --filter undo-fakes --filter undo-eve test",
    "test:e2e": "pnpm --filter support-agent test:e2e",
    "eval": "pnpm --filter support-agent eval",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm eval && pnpm demo"
  }
}
